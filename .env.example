POSTGRES_DB=survey
POSTGRES_USER=survey
POSTGRES_PASSWORD=survey
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/survey
DB_USERNAME=survey
DB_PASSWORD=survey

# Bootstrap a first local administrator. Change these values before use.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me
ADMIN_SESSION_HOURS=12

# Set false only for local HTTP development. Production should remain true behind HTTPS.
ADMIN_COOKIE_SECURE=false

# Read-only presentation link lifetime
PRESENTATION_TOKEN_HOURS=12

# Request/security limits. Reverse proxies should overwrite, not append/trust, incoming X-Forwarded-For/X-Real-IP.
HTTP_MAX_BODY_SIZE=1M
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_PUBLIC_PER_MINUTE=600
RATE_LIMIT_PRESENTATION_PER_MINUTE=600
