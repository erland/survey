# Release selection
APP_VERSION=0.1.0-rc.1
FRONTEND_IMAGE=ghcr.io/erland/survey-frontend
BACKEND_IMAGE=ghcr.io/erland/survey-backend

# Shared PostgreSQL
DB_HOST=replace-with-coolify-internal-postgres-host
DB_PORT=5432
DB_NAME=survey
DB_USERNAME=survey
DB_PASSWORD=replace-with-long-random-password

# Optional one-time bootstrap credentials.
# Remove or blank these after the first administrator has been created.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-long-random-password

# Session / presentation
ADMIN_SESSION_HOURS=12
PRESENTATION_TOKEN_HOURS=12

# Security
HTTP_MAX_BODY_SIZE=1M
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_PUBLIC_PER_MINUTE=600
RATE_LIMIT_PRESENTATION_PER_MINUTE=600
