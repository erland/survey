POSTGRES_DB=survey
POSTGRES_USER=survey
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD

# Only the frontend is exposed from Compose. Put your HTTPS reverse proxy in front of this port.
APP_PORT=8088

# Optional one-time bootstrap credentials. Remove/blank after the first administrator exists.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
ADMIN_SESSION_HOURS=12
PRESENTATION_TOKEN_HOURS=12

HTTP_MAX_BODY_SIZE=1M
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_PUBLIC_PER_MINUTE=600
RATE_LIMIT_PRESENTATION_PER_MINUTE=600
